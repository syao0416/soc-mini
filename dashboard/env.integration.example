# Add these lines to dashboard/.env on your own computer; never commit real values.
# Leave SOC_LOGS_* unset to continue using the existing LOCAL database snapshot.
# VM4 host-only example: only if API container can reach VM4 on a private network.
SOC_LOGS_HOST=192.168.56.140
SOC_LOGS_PORT=3306
SOC_LOGS_DB=socdb
SOC_LOGS_USER=soc_viewer
SOC_LOGS_PASSWORD=REPLACE_WITH_VM4_READ_ONLY_PASSWORD
# Only needed for approved VM2 action file export; same key stays on VM2 in /etc/violet-soc/vm2_signing_key
SOC_VM2_SIGNING_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET
