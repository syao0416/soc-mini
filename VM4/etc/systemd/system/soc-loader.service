[Unit]
Description=SOC Database Loader
After=docker.service soc-normalizer.service
Requires=docker.service

[Service]
Type=simple
User=student
WorkingDirectory=/home/student/soc-lab/soc
EnvironmentFile=/etc/soc/loader.env
ExecStart=/home/student/soc-lab/soc/.venv/bin/python -u -m loader.main --follow
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
